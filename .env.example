# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL (Cloud SQL en AI Studio o Supabase en Render mediante método de objeto)
SQL_HOST=
SQL_PORT=6543
SQL_DB_NAME=postgres
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
SQL_SSL=true

# Correo con rol de administrador inicial
ADMIN_EMAIL=
